// Neoantigen selection reproducibility study — generation workflow config.
//
// Container tags are pinned deliberately. Pinning versions is the whole point
// of a study about whether output shifts under a dependency upgrade; an
// unpinned tag would make the results unreproducible by construction.

manifest {
    name            = 'neoantigen-selection-stability'
    description      = 'Generates neoantigen candidates across MHC class I predictors for a concordance study'
    author          = 'Sophia Kehn Jannetty'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.10.0'
    version         = '0.1.0'
}

params {
    help           = false

    // --- inputs -------------------------------------------------------------
    input          = null      // samplesheet CSV: sample,hla,expression
    maf            = null      // mc3.v0.2.8.PUBLIC.maf.gz
    outdir         = 'results'

    // --- reference ----------------------------------------------------------
    // IMPORTANT: MC3 v0.2.8 is called against GRCh37, not GRCh38. The reference
    // FASTA and VEP cache must match the MAF's NCBI_Build column. Check it:
    //   zcat mc3.v0.2.8.PUBLIC.maf.gz | head -2 | cut -f4
    // GDC harmonized RNA-seq is GRCh38, but expression joins on Ensembl gene
    // ID, so the build mismatch does not matter for the expression step.
    ref_fasta         = null   // GRCh37 primary assembly FASTA (bgzipped ok)
    vep_cache         = null   // VEP offline cache directory, matching assembly
    vep_cache_version = 116
    vep_plugins       = null   // clone of griffithlab/VEP_plugins
    vep_assembly      = 'GRCh37'

    // --- prediction ---------------------------------------------------------
    // Set this from bin/smoke_test.sh output. Do not guess.
    // MixMHCpred and PRIME are excluded: they need a separate academic license.
    predictors        = 'MHCflurry,MHCnuggetsI,NetMHCpan,SMM,PickPocket,BigMHC_EL,DeepImmuno'
    epitope_lengths   = '8,9,10,11'

    // pVACseq filtering. expn_val = 0 disables the expression filter, which is
    // the control arm for question 4 (filter sensitivity).
    binding_threshold = 500
    expn_val          = 1.0
    top_n             = 34     // candidates encoded by a real INT product

    // --- resources ----------------------------------------------------------
    max_cpus          = 8
    max_memory        = '16.GB'
    max_time          = '24.h'

    // Suffix for the timeline/report/trace filenames, so reruns do not
    // overwrite each other's evidence.
    trace_report_suffix = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')
}

process {
    errorStrategy = { task.exitStatus in [104,134,137,139,143,247] ? 'retry' : 'finish' }
    maxRetries    = 2

    cpus   = 2
    memory = '4.GB'
    time   = '2.h'

    withLabel: process_low {
        cpus = 1; memory = '2.GB'; time = '1.h'
    }
    withLabel: process_medium {
        cpus = { Math.min(4, params.max_cpus as int) }
        memory = { [8.GB, params.max_memory as nextflow.util.MemoryUnit].min() }
        time   = '4.h'
    }
    withLabel: process_high {
        cpus = { Math.min(8, params.max_cpus as int) }
        memory = { [16.GB, params.max_memory as nextflow.util.MemoryUnit].min() }
        time   = '12.h'
    }

    withName: MAF2VCF {
        container = 'quay.io/biocontainers/vcf2maf:1.6.21--hdfd78af_0'
    }
    withName: VEP_ANNOTATE {
        container = 'ensemblorg/ensembl-vep:release_116.0'
    }
    withName: 'ANNOTATE_EXPRESSION|PVACSEQ' {
        container = 'griffithlab/pvactools:7.1.6'
    }
}

profiles {
    docker {
        docker.enabled = true
        docker.fixOwnership = true
        // Many bioinformatics containers are x86_64 only. Harmless on Linux,
        // required on Apple Silicon.
        docker.runOptions = '--platform linux/amd64'
    }

    // Apple Silicon local runs: emulated, so keep the matrix tiny.
    local_arm {
        docker.enabled = true
        docker.fixOwnership = true
        docker.runOptions = '--platform linux/amd64'
        params.predictors = 'MHCflurry,MHCnuggetsI'
        params.epitope_lengths = '9'
        process.cpus = 2
    }

    // Linux host / EC2: the full matrix.
    aws_ec2 {
        docker.enabled = true
        docker.fixOwnership = true
        params.max_cpus = 8
    }

    test {
        params.predictors = 'MHCflurry'
        params.epitope_lengths = '9'
    }
}

// `log` is not bound in config scope, so this uses println.
workflow.onComplete = {
    println( workflow.success
        ? "\nDone. Results in ${params.outdir}\nPredictors run: ${params.predictors}\n"
        : "\nFailed. See ${params.outdir}/pipeline_info/ for the trace.\n" )
}

// Reports are evidence. Keep them.
// The timestamp lives in params because the strict config parser (Nextflow 25+)
// rejects `def` declarations here. This is also the nf-core convention.
timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/timeline_${params.trace_report_suffix}.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/report_${params.trace_report_suffix}.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/trace_${params.trace_report_suffix}.txt"
}
